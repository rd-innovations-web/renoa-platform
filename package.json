{
  "name": "renoa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "RENOA by Treeblock - Interior Design & Project Management Platform",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter @renoa/api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @renoa/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}